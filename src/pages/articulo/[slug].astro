---
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Boletin from "../../components/Boletin.astro";
import { nombreSeccion, minutosLectura } from "../../consts";

export const getStaticPaths = (async () => {
  const articulos = await getCollection("articulos", ({ data }) => !data.borrador);
  return articulos.map((articulo) => ({
    params: { slug: articulo.id },
    props: { articulo },
  }));
}) satisfies GetStaticPaths;

const { articulo } = Astro.props;
const { titulo, bajada, seccion, fecha, etiquetas, portada, creditoPortada } = articulo.data;
const { origen, firma, fuente, fuenteUrl, original, licencia, licenciaUrl } = articulo.data;
const esSindicada = origen === "sindicada";

const autor = await getEntry(articulo.data.autor);
const { Content } = await render(articulo);
const min = minutosLectura(articulo.body);

const fechaTxt = fecha.toLocaleDateString("es-AR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const kicker = etiquetas[0] ? `${nombreSeccion(seccion)} · ${etiquetas[0]}` : nombreSeccion(seccion);
const autoria = esSindicada ? firma || fuente || "Medios aliados" : autor.data.nombre;
---
<Base titulo={titulo} descripcion={bajada} activa={seccion}>
  <main class="contenedor">
    <article class="articulo">
      <p class="kicker">{kicker}</p>
      <h1>{titulo}</h1>
      <p class="dek">{bajada}</p>

      <div class="articulo__meta">
        <span class="byline">Por <strong>{autoria}</strong></span>
        {esSindicada && fuente && (
          <span class="byline">vía {fuenteUrl ? <a href={fuenteUrl} target="_blank" rel="noopener">{fuente}</a> : fuente}</span>
        )}
        <span class="byline">{fechaTxt}</span>
        <span class="minutos">{min} min de lectura</span>
      </div>

      {esSindicada && (
        <p class="sindicada-aviso">
          Nota reproducida de <strong>{fuente}</strong> bajo licencia{" "}
          {licenciaUrl ? <a href={licenciaUrl} target="_blank" rel="noopener">{licencia}</a> : licencia}.
          Kitus no modifica el texto. {original && (<a href={original} target="_blank" rel="noopener">Ver original &rsaquo;</a>)}
        </p>
      )}

      {!esSindicada && (
        <figure class="articulo__hero">
          {portada ? <img src={portada} alt={creditoPortada ?? ""} /> : <div class="ph"></div>}
          {creditoPortada
            ? <figcaption>{creditoPortada}</figcaption>
            : <figcaption>Prototipo: aquí iría la foto de apertura con su epígrafe y crédito.</figcaption>}
        </figure>
      )}

      <div class="cuerpo">
        <Content />
      </div>

      {etiquetas.length > 0 && (
        <div class="etiquetas">
          {etiquetas.map((t) => <a href={`/${seccion}/`}>{t}</a>)}
        </div>
      )}

      {esSindicada ? (
        <div class="credito-fuente">
          <p>
            Publicado originalmente en{" "}
            {original ? <a href={original} target="_blank" rel="noopener">{fuente}</a> : fuente}.
            Reproducido por Kitus bajo licencia{" "}
            {licenciaUrl ? <a href={licenciaUrl} target="_blank" rel="noopener">{licencia}</a> : licencia}.
          </p>
        </div>
      ) : (
        <div class="autor-bio">
          <div class="avatar">{autor.data.iniciales}</div>
          <div>
            <h4>{autor.data.nombre}</h4>
            <p>{autor.data.bio}</p>
          </div>
        </div>
      )}
    </article>
  </main>
  <Boletin />
</Base>
