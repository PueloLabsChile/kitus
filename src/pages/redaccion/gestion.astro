---
import Base from "../../layouts/Base.astro";
const cuentas = [["Gonzalo Escobar Arevalo","Administración editorial","Activa","Hoy, 10:18"],["Juan Carlos Herrera","Administración editorial","Activa","Hoy, 09:45"],["Camila Ferreira Valdez","Corresponsal / Madrid","Activa","Hoy, 12:40"],["Astrid Velazquez","Corresponsal","Activa","Ayer, 18:12"],["Emilia Guzman","Corresponsal","Activa","Ayer, 16:40"],["Pedro Santander","Corresponsal / Relatos","Activa","Ayer, 15:20"]];
const modulos = [
  ["Sala editorial","Vista total de actividad, turnos y agenda.","/redaccion/"],
  ["Turno de Camila","Nota diaria, bitacora y encargos desde Madrid.","/redaccion/#turno-titulo"],
  ["Periodistas agenticos","Encargos, borradores y control de salida IA.","/redaccion/#ia-titulo"],
  ["Revisiones","Cola RSS, fuentes e imagenes por aprobar.","/redaccion/revisiones/"],
  ["Corresponsales","Cuentas, actividad y articulos propios.","#corresponsales"],
  ["Seguridad","Roles, invitaciones, accesos y sesiones.","#seguridad"],
];
---
<Base titulo="Gestion editorial" activa="redaccion"><main class="contenedor gestion"><header class="gestion__cab"><div><p class="kicker">Jefatura editorial</p><h1>Gestion de accesos</h1><p>La consola de Gonzalo Escobar y Juan Carlos Herrera para dirigir la redaccion.</p></div><div class="gestion__usuario"><img src="/images/equipo/gonzalo-escobar.jpeg" alt=""/><span><strong>Jefatura activa</strong><small>Control editorial</small></span><a class="sala__crear-link" href="/redaccion/nuevo-articulo/">Escribir nota</a></div></header>
<nav class="gestion__nav" aria-label="Modulos de jefatura">{modulos.map(([nombre, descripcion, url], indice)=><a href={url}><span>{String(indice+1).padStart(2,"0")}</span><strong>{nombre}</strong><small>{descripcion}</small></a>)}</nav>
<section class="gestion__indicadores"><div><strong>06</strong><span>Cuentas activas</span></div><div><strong>02</strong><span>Jefaturas</span></div><div><strong>02</strong><span>Notas en revision</span></div><div><strong>01</strong><span>Turno de Camila</span></div></section>
<section class="gestion__prioridades" id="revision"><div><p class="kicker">Prioridad editorial</p><h2>Revision de hoy</h2><article><span>01</span><div><strong>Camila Ferreira &middot; Nota diaria</strong><p>Europa en movimiento: claves para leer la jornada desde Madrid.</p></div><button type="button">Abrir revision</button></article><article><span>02</span><div><strong>Equipo &middot; Borrador pendiente</strong><p>Verificar fuentes, imagen y credito antes de publicar.</p></div><button type="button">Abrir revision</button></article></div><aside><p class="kicker">Periodistas agenticos</p><h2>Supervision IA</h2><p>Los agentes pueden preparar estructura y contexto. La jefatura aprueba cada fuente, firma y publicacion.</p><a href="/redaccion/#ia-titulo">Ir a la mesa de analisis</a></aside></section>
<section class="gestion__contenido" id="corresponsales"><div class="gestion__tabla"><div class="gestion__titulo"><div><p class="kicker">Directorio</p><h2>Equipo con acceso</h2></div><button type="button">Nueva cuenta</button></div><div class="gestion__encabezado"><span>Persona</span><span>Permiso</span><span>Estado</span><span>Ultimo acceso</span><span></span></div>{cuentas.map(([nombre,rol,estado,ultimo])=><article class="gestion__fila"><strong>{nombre}</strong><span>{rol}</span><span>{estado}</span><time>{ultimo}</time><button type="button">Editar</button></article>)}</div><aside class="gestion__reglas" id="seguridad"><p class="kicker">Permisos</p><h2>Reglas activas</h2><dl><dt>Jefaturas</dt><dd>Gonzalo Escobar y Juan Carlos Herrera ven toda la sala, los agentes IA y las revisiones.</dd><dt>Corresponsales</dt><dd>Solo crean y editan sus propios borradores.</dd><dt>Publicacion</dt><dd>Requiere una jefatura responsable.</dd></dl><button type="button">Editar permisos</button></aside></section></main><script>const s=JSON.parse(localStorage.getItem("kitus-sesion-prueba")||"null");if(!s||s.rol!=="jefatura")window.location.href="/acceso/";</script></Base>