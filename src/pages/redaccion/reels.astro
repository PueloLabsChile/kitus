---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const notas = (await getCollection("articulos", ({ data }) => !data.borrador))
  .sort((a, b) => +new Date(b.data.fechaIncorporacion || b.data.fecha) - +new Date(a.data.fechaIncorporacion || a.data.fecha))
  .slice(0, 40);
---
<Base titulo="Constructor de reels" activa="redaccion">
  <main class="contenedor reels-editor">
    <header class="reels-editor__cab">
      <div><p class="kicker">Mesa audiovisual</p><h1>Constructor de reels</h1><p>Convierte una nota en una secuencia vertical para Instagram. Esta es la plantilla editorial provisional de Kitus.</p></div>
      <a href="/redaccion/redes/">Volver a publicaciones</a>
    </header>

    <section class="reels-editor__nota">
      <label for="reel-nota">Nota de origen</label>
      <select id="reel-nota">
        {notas.map((nota) => <option value={nota.slug} data-bajada={nota.data.bajada} data-imagen={nota.data.portada || ""}>{nota.data.titulo}</option>)}
      </select>
      <small>La fuente y el enlace a Kitus se conservarán en el cierre del reel.</small>
    </section>

    <section class="reels-editor__mesa">
      <form class="reels-editor__controles" id="reel-form">
        <div class="reels-editor__pasos"><button type="button" data-escena="0" class="activo">01 Portada</button><button type="button" data-escena="1">02 Contexto</button><button type="button" data-escena="2">03 Cierre</button></div>
        <fieldset data-panel="0"><legend>Portada</legend><label>Titular<textarea id="escena-titulo" rows="4" maxlength="120"></textarea></label><label>Imagen de portada<input id="escena-imagen" type="file" accept="image/jpeg,image/png,image/webp" /></label></fieldset>
        <fieldset data-panel="1" hidden><legend>Contexto</legend><label>Idea central<textarea id="escena-contexto" rows="5" maxlength="220" placeholder="Explica el dato o contexto más relevante."></textarea></label><label>Etiqueta<input id="escena-etiqueta" maxlength="36" value="ANÁLISIS KITUS" /></label><label>Imagen de contexto<input id="escena-imagen-2" type="file" accept="image/jpeg,image/png,image/webp" /></label></fieldset>
        <fieldset data-panel="2" hidden><legend>Cierre</legend><label>Llamado a la acción<textarea id="escena-cierre" rows="3" maxlength="100">Lee la nota completa en kitus.cl</textarea></label><label>Imagen de cierre<input id="escena-imagen-3" type="file" accept="image/jpeg,image/png,image/webp" /></label><label>Duración por escena<select id="reel-duracion"><option value="2.5">2,5 segundos</option><option value="3" selected>3 segundos</option><option value="4">4 segundos</option></select></label></fieldset>
        <div class="reels-editor__acciones"><button type="button" id="reel-reproducir">Previsualizar</button><button type="button" class="secundario" id="reel-guardar">Guardar proyecto</button><button type="button" class="secundario" id="reel-guion">Descargar guion</button><button type="button" id="reel-render">Solicitar MP4</button></div>
        <p id="reel-mensaje" role="status"></p>
      </form>

      <aside class="reels-editor__vista"><div class="reel-marco" aria-label="Vista previa vertical del reel"><div class="reel-escena reel-escena--portada activa" data-vista="0"><div class="reel-escena__imagen" id="vista-imagen"></div><div class="reel-escena__velo"></div><div class="reel-escena__contenido"><span id="vista-etiqueta">ANÁLISIS KITUS</span><h2 id="vista-titulo">Selecciona una nota</h2><small>kitus.cl</small></div></div><div class="reel-escena reel-escena--contexto" data-vista="1"><span id="vista-etiqueta-2">ANÁLISIS KITUS</span><p id="vista-contexto">El contexto clave aparecerá aquí.</p><strong>01</strong></div><div class="reel-escena reel-escena--cierre" data-vista="2"><div class="reel-marca">KITUS</div><p id="vista-cierre">Lee la nota completa en kitus.cl</p><small>Periodismo y análisis internacional</small></div></div><p class="reels-editor__formato">1080 × 1920 · 9:16 · Instagram Reel</p></aside>
    </section>
    <section class="reels-editor__nota-tecnica"><strong>Render profesional</strong><p>El proyecto queda listo para renderizar en MP4 cuando conectemos el servicio de video. Por ahora puedes previsualizar, guardar el proyecto y descargar su guion editorial.</p></section>
  </main>

  <script>
    const sel=document.getElementById("reel-nota"),titulo=document.getElementById("escena-titulo"),contexto=document.getElementById("escena-contexto"),etiqueta=document.getElementById("escena-etiqueta"),cierre=document.getElementById("escena-cierre"),imagen=document.getElementById("escena-imagen"),imagen2=document.getElementById("escena-imagen-2"),imagen3=document.getElementById("escena-imagen-3"),mensaje=document.getElementById("reel-mensaje"),panels=[...document.querySelectorAll("[data-panel]")],pasos=[...document.querySelectorAll("[data-escena]")],vistas=[...document.querySelectorAll("[data-vista]")];let escena=0,temporizador;
    const datos=()=>({nota:sel.value,titulo:titulo.value,contexto:contexto.value,etiqueta:etiqueta.value,cierre:cierre.value,duracion:document.getElementById("reel-duracion").value,fecha:new Date().toISOString()});
    const actualizar=()=>{const o=sel.selectedOptions[0];if(!titulo.value||titulo.dataset.auto==="1"){titulo.value=o.textContent;titulo.dataset.auto="1"}if(!contexto.value||contexto.dataset.auto==="1"){contexto.value=o.dataset.bajada||"";contexto.dataset.auto="1"}document.getElementById("vista-titulo").textContent=titulo.value||"Selecciona una nota";document.getElementById("vista-contexto").textContent=contexto.value||"El contexto clave aparecerá aquí.";document.getElementById("vista-etiqueta").textContent=etiqueta.value||"KITUS";document.getElementById("vista-etiqueta-2").textContent=etiqueta.value||"KITUS";document.getElementById("vista-cierre").textContent=cierre.value||"Lee la nota completa en kitus.cl";if(!document.getElementById("vista-imagen").style.backgroundImage&&o.dataset.imagen)document.getElementById("vista-imagen").style.backgroundImage=`url('${o.dataset.imagen}')`};
    const mostrar=(n)=>{escena=n;pasos.forEach((b,i)=>b.classList.toggle("activo",i===n));panels.forEach((p,i)=>p.hidden=i!==n);vistas.forEach((v,i)=>v.classList.toggle("activa",i===n))};
    pasos.forEach(b=>b.onclick=()=>mostrar(+b.dataset.escena));sel.onchange=()=>{titulo.dataset.auto="1";contexto.dataset.auto="1";document.getElementById("vista-imagen").style.backgroundImage="";actualizar()};[titulo,contexto,etiqueta,cierre].forEach(x=>x.oninput=()=>{x.dataset.auto="0";actualizar()});const cargarImagen=(input,vista)=>{const f=input.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{vista.style.backgroundImage=`linear-gradient(rgba(10,10,10,.36),rgba(10,10,10,.72)),url('${r.result}')`;vista.classList.add("con-imagen")};r.readAsDataURL(f)};imagen.onchange=()=>cargarImagen(imagen,document.getElementById("vista-imagen"));imagen2.onchange=()=>cargarImagen(imagen2,vistas[1]);imagen3.onchange=()=>cargarImagen(imagen3,vistas[2]);
    document.getElementById("reel-reproducir").onclick=()=>{clearInterval(temporizador);mostrar(0);const ms=+document.getElementById("reel-duracion").value*1000;temporizador=setInterval(()=>mostrar((escena+1)%3),ms);mensaje.textContent="Vista previa en reproducción."};
    document.getElementById("reel-guardar").onclick=()=>{localStorage.setItem("kitus-reel-proyecto",JSON.stringify(datos()));mensaje.textContent="Proyecto guardado en este navegador."};
    document.getElementById("reel-guion").onclick=()=>{const blob=new Blob([JSON.stringify(datos(),null,2)],{type:"application/json"}),a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="reel-kitus.json";a.click();URL.revokeObjectURL(a.href);mensaje.textContent="Guion descargado."};
    document.getElementById("reel-render").onclick=()=>mensaje.textContent="El proyecto está listo. La exportación MP4 se activará al conectar el renderizador de video.";actualizar();
  </script>
</Base>

<style>
.reels-editor{padding-block:3rem 5rem}.reels-editor__cab{display:flex;justify-content:space-between;gap:2rem;align-items:end;padding-bottom:1.4rem;border-bottom:2px solid var(--tinta)}.reels-editor__cab h1{margin:.25rem 0;font-size:clamp(2.3rem,5vw,4.4rem)}.reels-editor__cab p:last-child{max-width:45rem;margin:0;color:var(--gris);font:1rem/1.6 var(--sans)}.reels-editor__cab>a{font:700 .75rem var(--sans);color:var(--tinta);white-space:nowrap}.reels-editor__nota{padding:1rem 0;border-bottom:1px solid var(--linea);font:700 .76rem var(--sans);letter-spacing:.04em;text-transform:uppercase}.reels-editor__nota select{max-width:42rem;margin-left:1rem;padding:.55rem;border:1px solid var(--linea);background:#fff;font:400 .9rem var(--sans)}.reels-editor__nota small{display:block;margin-top:.7rem;color:var(--gris);font:400 .75rem var(--sans);letter-spacing:0;text-transform:none}.reels-editor__mesa{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.72fr);gap:3.5rem;padding-top:2rem}.reels-editor__pasos{display:flex;gap:.4rem;border-bottom:1px solid var(--linea);padding-bottom:1rem;margin-bottom:1.3rem}.reels-editor__pasos button{border:0;background:transparent;color:var(--gris);padding:.35rem .15rem;margin-right:1rem;font:700 .7rem var(--sans);letter-spacing:.04em;cursor:pointer}.reels-editor__pasos button.activo{color:var(--rojo);border-bottom:2px solid var(--rojo)}.reels-editor fieldset{margin:0;padding:0;border:0}.reels-editor legend{margin-bottom:1rem;font:700 1.35rem var(--serif)}.reels-editor label{display:block;margin:1rem 0;font:700 .72rem var(--sans);letter-spacing:.05em;text-transform:uppercase}.reels-editor textarea,.reels-editor input,.reels-editor select{display:block;box-sizing:border-box;width:100%;margin-top:.45rem;padding:.75rem;border:1px solid var(--linea);background:#fff;color:var(--tinta);font:400 .95rem/1.45 var(--sans);letter-spacing:0;text-transform:none}.reels-editor__acciones{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1.6rem}.reels-editor__acciones button{border:1px solid var(--tinta);background:var(--tinta);color:#fff;padding:.7rem .85rem;font:700 .7rem var(--sans);letter-spacing:.04em;text-transform:uppercase;cursor:pointer}.reels-editor__acciones .secundario{background:transparent;color:var(--tinta)}#reel-mensaje{min-height:1.3rem;color:var(--rojo);font:.78rem var(--sans)}.reels-editor__vista{justify-self:center;width:min(100%,20rem)}.reel-marco{position:relative;aspect-ratio:9/16;overflow:hidden;background:#0d0d0d;box-shadow:0 16px 40px rgba(0,0,0,.2)}.reel-escena{position:absolute;inset:0;display:none}.reel-escena.activa{display:flex}.reel-escena--portada{align-items:flex-end;color:#fff}.reel-escena__imagen{position:absolute;inset:0;background:linear-gradient(145deg,#4e1a14,#161616 62%,#c53d2d);background-size:cover;background-position:center}.reel-escena__velo{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.12),rgba(0,0,0,.88))}.reel-escena__contenido{position:relative;padding:1.4rem}.reel-escena span{color:#f2a29a;font:800 .62rem var(--sans);letter-spacing:.12em}.reel-escena h2{margin:.6rem 0 1.3rem;font-size:2rem;line-height:.95}.reel-escena small{font:700 .62rem var(--sans);letter-spacing:.08em;text-transform:uppercase}.reel-escena--contexto{flex-direction:column;justify-content:space-between;padding:1.4rem;background:#ece8df;background-size:cover;background-position:center}.reel-escena--contexto.con-imagen{color:#fff;text-shadow:0 2px 12px rgba(0,0,0,.7)}.reel-escena--contexto p{margin:auto 0;font:2rem/.98 var(--serif)}.reel-escena--contexto strong{align-self:flex-end;color:var(--rojo);font:5rem/.8 var(--serif)}.reel-escena--cierre{flex-direction:column;justify-content:center;align-items:center;padding:2rem;text-align:center;color:#fff;background:#121212;background-size:cover;background-position:center;background-blend-mode:overlay}.reel-marca{color:#f04a3a;font:900 3rem var(--sans);letter-spacing:.06em}.reel-escena--cierre p{font:1.8rem/1 var(--serif)}.reels-editor__formato{margin:.7rem 0 0;text-align:center;color:var(--gris);font:.66rem var(--sans);letter-spacing:.07em;text-transform:uppercase}.reels-editor__nota-tecnica{display:flex;gap:1rem;margin-top:3rem;padding:1rem;border-top:2px solid var(--tinta);border-bottom:1px solid var(--linea);font:.82rem/1.5 var(--sans)}.reels-editor__nota-tecnica strong{white-space:nowrap;text-transform:uppercase;letter-spacing:.06em}.reels-editor__nota-tecnica p{margin:0;color:var(--gris)}@media(max-width:720px){.reels-editor__cab,.reels-editor__mesa,.reels-editor__nota-tecnica{display:block}.reels-editor__cab>a{display:inline-block;margin-top:1rem}.reels-editor__nota select{display:block;width:100%;max-width:none;margin:.6rem 0 0}.reels-editor__vista{margin:2.5rem auto}.reels-editor__nota-tecnica strong{display:block;margin-bottom:.5rem}}
</style>