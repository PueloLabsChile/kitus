---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const extraerIdeas = (texto = "") => texto
  .replace(/^---[\s\S]*?---/, "")
  .replace(/!?(?:\[[^\]]*\])?\([^)]*\)/g, "")
  .replace(/[#*_>`]/g, " ")
  .replace(/\s+/g, " ")
  .split(/(?<=[.!?])\s+/)
  .map((frase) => frase.trim())
  .filter((frase) => frase.length >= 45 && frase.length <= 230)
  .slice(0, 4);

const notas = (await getCollection("articulos", ({ data }) => !data.borrador))
  .sort((a, b) => +new Date(b.data.fechaIncorporacion || b.data.fecha) - +new Date(a.data.fechaIncorporacion || a.data.fecha))
  .slice(0, 40)
  .map((nota) => ({ ...nota, ideasReel: extraerIdeas(nota.body) }));
---
<Base titulo="Constructor de reels" activa="redaccion">
  <main class="contenedor reels-editor">
    <header class="reels-editor__cab">
      <div><p class="kicker">Mesa audiovisual</p><h1>Constructor de reels</h1><p>Arma una secuencia vertical de cinco imágenes —o las que necesites— desde una nota de Kitus.</p></div>
      <a href="/redaccion/redes/">Volver a publicaciones</a>
    </header>

    <section class="reels-editor__nota">
      <label for="reel-nota">Nota de origen</label>
      <select id="reel-nota">
        {notas.map((nota) => <option value={nota.slug} data-bajada={nota.data.bajada} data-imagen={nota.data.portada || ""} data-ideas={JSON.stringify(nota.ideasReel)}>{nota.data.titulo}</option>)}
      </select>
      <small>La fuente y el enlace a Kitus se conservarán en el cierre del reel.</small>
    </section>

    <section class="reels-editor__mesa">
      <form class="reels-editor__controles" id="reel-form">
        <div class="reels-editor__pasos" id="escena-tabs" aria-label="Escenas del reel"></div>
        <button class="agregar-escena" type="button" id="agregar-escena">+ Añadir escena</button>
        <fieldset><legend id="escena-nombre">Escena</legend>
          <label>Texto principal<textarea id="escena-texto" rows="4" maxlength="180"></textarea></label>
          <label>Etiqueta<input id="escena-etiqueta" maxlength="36" value="ANÁLISIS KITUS" /></label>
          <div class="reels-editor__imagen-titulo"><strong>Imagen de esta escena</strong><small>Una imagen por escena, con crédito editorial.</small></div>
          <label class="carga-local">Subir desde el equipo<input id="escena-imagen" type="file" accept="image/jpeg,image/png,image/webp" /></label>
          <section class="buscador-imagenes" aria-label="Buscador profesional de imágenes">
            <div><p class="buscador-imagenes__titulo">Buscar imágenes profesionales</p><p>Banco editorial Openverse: selecciona imágenes con licencia visible y atribución incorporada.</p></div>
            <div class="buscador-imagenes__barra"><input id="buscador-imagen" type="search" placeholder="Ej.: elecciones África, protesta, tribunal" /><button type="button" id="buscar-imagen">Buscar</button></div>
            <p class="buscador-imagenes__ayuda">Filtramos resultados reutilizables (CC0, PDM, CC BY y CC BY-SA). Verifica la licencia antes de publicar.</p><p class="sugerencia-imagen" id="sugerencia-imagen"></p>
            <div class="buscador-imagenes__resultados" id="resultados-imagenes" aria-live="polite"></div>
          </section>
          <p class="credito-imagen" id="credito-imagen">Aún no hay imagen seleccionada.</p>
          <label>Formato de Instagram<select id="reel-formato"><option value="reel">Reel / Historia · 1080 × 1920</option><option value="retrato">Publicación vertical · 1080 × 1350</option><option value="cuadrado">Publicación cuadrada · 1080 × 1080</option><option value="horizontal">Publicación horizontal · 1080 × 566</option></select></label><label>Duración por escena<select id="reel-duracion"><option value="2.5">2,5 segundos</option><option value="3" selected>3 segundos</option><option value="4">4 segundos</option></select></label>
        </fieldset>
        <div class="reels-editor__acciones"><button type="button" id="reel-reproducir">Previsualizar</button><button type="button" class="secundario" id="reel-guardar">Guardar proyecto</button><button type="button" class="secundario" id="reel-guion">Descargar guion</button><button type="button" class="secundario" id="reel-descargar-laminas">Descargar láminas PNG</button><button type="button" id="reel-render">Solicitar MP4</button></div>
        <p id="reel-mensaje" role="status"></p>
      </form>

      <aside class="reels-editor__vista"><div class="reel-marco formato-reel" id="reel-marco" aria-label="Vista previa del formato de Instagram seleccionado"><div class="reel-escena" id="vista-escena"><div class="reel-escena__imagen" id="vista-imagen"></div><div class="reel-escena__velo"></div><div class="reel-escena__contenido"><span id="vista-etiqueta">ANÁLISIS KITUS</span><h2 id="vista-texto">Selecciona una nota</h2><small id="vista-pie">01 · kitus.cl</small></div></div></div><p class="reels-editor__formato" id="reels-formato">1080 × 1920 · 9:16 · Reel / Historia</p></aside>
    </section>
    <section class="reels-editor__nota-tecnica"><strong>Uso editorial</strong><p>El buscador muestra autor y licencia de cada imagen seleccionada. El proyecto guarda esos créditos; antes de exportar, confirma que la licencia corresponde al uso de Kitus.</p></section>
  </main>

  <script>
    const sel = document.getElementById("reel-nota");
    const tabs = document.getElementById("escena-tabs"), texto = document.getElementById("escena-texto"), etiqueta = document.getElementById("escena-etiqueta"), archivo = document.getElementById("escena-imagen"), duracion = document.getElementById("reel-duracion"), mensaje = document.getElementById("reel-mensaje"), credito = document.getElementById("credito-imagen"), resultados = document.getElementById("resultados-imagenes"), buscador = document.getElementById("buscador-imagen"), formato = document.getElementById("reel-formato"), sugerencia = document.getElementById("sugerencia-imagen"), marco = document.getElementById("reel-marco"), formatoVista = document.getElementById("reels-formato"), vistaImagen = document.getElementById("vista-imagen"), vistaTexto = document.getElementById("vista-texto"), vistaEtiqueta = document.getElementById("vista-etiqueta"), vistaPie = document.getElementById("vista-pie");
    let activa = 0, temporizador;
    const escenas = [
      { nombre: "Portada", texto: "", etiqueta: "ANÁLISIS KITUS", sugerencia: "Busca una imagen principal del hecho, con un sujeto claro y espacio oscuro para el titular.", imagen: null },
      { nombre: "Contexto", texto: "", etiqueta: "CONTEXTO", sugerencia: "Busca el lugar, territorio o escena que explique dónde ocurre la historia.", imagen: null },
      { nombre: "Dato clave", texto: "", etiqueta: "EN CIFRAS", sugerencia: "Busca un detalle, documento, mapa o símbolo que acompañe el dato central.", imagen: null },
      { nombre: "Mirada", texto: "", etiqueta: "ANÁLISIS", sugerencia: "Busca un retrato, gesto o escena humana que aporte profundidad editorial.", imagen: null },
      { nombre: "Cierre", texto: "Lee la nota completa en kitus.cl", etiqueta: "KITUS", sugerencia: "Busca una imagen sobria y limpia; debe dejar aire visual para el llamado a la acción.", imagen: null }
    ];
    const escapeHtml = (v) => String(v || "").replace(/[&<>'"]/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;","\"":"&quot;"})[c]);
    const formatos = { reel: { nombre: "Reel / Historia", medida: "1080 × 1920 · 9:16" }, retrato: { nombre: "Publicación vertical", medida: "1080 × 1350 · 4:5" }, cuadrado: { nombre: "Publicación cuadrada", medida: "1080 × 1080 · 1:1" }, horizontal: { nombre: "Publicación horizontal", medida: "1080 × 566 · 1.91:1" } };
    const notaActual = () => sel.selectedOptions[0];
    const ajustarTexto = () => { const largo = vistaTexto.textContent.trim().length || 1; const reglas = { reel: { max: 2.05, min: 1.02, caracteres: 42 }, retrato: { max: 1.72, min: .92, caracteres: 40 }, cuadrado: { max: 1.52, min: .84, caracteres: 34 }, horizontal: { max: 1.22, min: .68, caracteres: 28 } }[formato.value]; const lineas = Math.max(1, Math.ceil(largo / reglas.caracteres)); const reduccion = formato.value === "horizontal" ? .14 : .18; const tam = Math.max(reglas.min, reglas.max - Math.max(0, lineas - 2) * reduccion); vistaTexto.style.fontSize = `${tam}rem`; vistaTexto.style.lineHeight = formato.value === "horizontal" ? "1.02" : ".98"; vistaTexto.style.maxWidth = formato.value === "horizontal" ? "86%" : "100%"; };
    const imagenFondo = (imagen) => imagen ? `linear-gradient(rgba(8,8,8,.18),rgba(8,8,8,.74)),url("${imagen.url}")` : "linear-gradient(145deg,#4e1a14,#161616 62%,#c53d2d)";
    const renderTabs = () => { tabs.innerHTML = escenas.map((e, i) => `<button type="button" class="${i === activa ? "activo" : ""}" data-escena="${i}">${String(i + 1).padStart(2,"0")} ${escapeHtml(e.nombre)}</button>`).join(""); tabs.querySelectorAll("button").forEach((b) => b.onclick = () => { activa = Number(b.dataset.escena); render(); }); };
    const render = () => {
      const e = escenas[activa];
      document.getElementById("escena-nombre").textContent = `${String(activa + 1).padStart(2,"0")} · ${e.nombre}`;
      texto.value = e.texto; etiqueta.value = e.etiqueta;
      vistaTexto.textContent = e.texto || "Escribe el mensaje de esta escena";
      vistaEtiqueta.textContent = e.etiqueta || "KITUS";
      vistaPie.textContent = `${String(activa + 1).padStart(2,"0")} · kitus.cl`;
      vistaImagen.style.backgroundImage = imagenFondo(e.imagen);
      credito.textContent = e.imagen ? `Crédito: ${e.imagen.credito}. Licencia: ${e.imagen.licencia}.` : "Aún no hay imagen seleccionada para esta escena.";
      marco.className = `reel-marco formato-${formato.value}`;
      formatoVista.textContent = `${formatos[formato.value].medida} · ${formatos[formato.value].nombre}`;
      ajustarTexto();
      renderTabs();
    };
    const completarNota = () => { const o = notaActual(); escenas[0].texto = o.textContent.trim(); escenas[1].texto = o.dataset.bajada || "Explica aquí el contexto principal de la noticia."; let ideas = []; try { ideas = JSON.parse(o.dataset.ideas || "[]"); } catch {} escenas[2].texto = ideas[0] || "No se encontró un dato clave en el cuerpo de esta nota."; escenas[3].texto = ideas[1] || ideas[2] || "No se encontró una segunda idea para esta mirada."; if (o.dataset.imagen) escenas[0].imagen = { url: o.dataset.imagen, credito: "Portada de la nota de Kitus", licencia: "Uso editorial Kitus" }; render(); };
    tabs.addEventListener("click", () => {});
    document.getElementById("agregar-escena").onclick = () => { escenas.push({ nombre: `Escena ${escenas.length + 1}`, texto: "", etiqueta: "KITUS", sugerencia: "Busca una imagen que ilustre con precisión el mensaje de esta escena y deje espacio para el texto.", imagen: null }); activa = escenas.length - 1; render(); };
    [texto, etiqueta].forEach((el) => el.oninput = () => { escenas[activa][el === texto ? "texto" : "etiqueta"] = el.value; render(); });
    sel.onchange = completarNota; formato.onchange = render;
    archivo.onchange = () => { const f = archivo.files[0]; if (!f) return; const r = new FileReader(); r.onload = () => { escenas[activa].imagen = { url: r.result, credito: "Archivo subido por la redacción", licencia: "Completar crédito antes de publicar" }; render(); }; r.readAsDataURL(f); };
    const usarResultado = (r) => { escenas[activa].imagen = { url: r.url || r.thumbnail, credito: `${r.creator || "Autor no indicado"} · ${r.source || "Openverse"}`, licencia: `${(r.license || "licencia por verificar").toUpperCase()}${r.license_version ? " " + r.license_version : ""}`, enlace: r.foreign_landing_url || r.url }; render(); mensaje.textContent = "Imagen y atribución añadidas a esta escena."; };
    document.getElementById("buscar-imagen").onclick = async () => { const q = buscador.value.trim(); if (!q) { mensaje.textContent = "Escribe qué imagen necesitas buscar."; return; } resultados.innerHTML = "<p>Buscando imágenes con licencia…</p>"; try { const respuesta = await fetch(`https://api.openverse.org/v1/images/?q=${encodeURIComponent(q)}&page_size=20`); if (!respuesta.ok) throw new Error("Servicio no disponible"); const data = await respuesta.json(); const permitidas = new Set(["cc0", "pdm", "by", "by-sa"]); const items = (data.results || []).filter((r) => permitidas.has(String(r.license || "").toLowerCase())).slice(0, 12); if (!items.length) { resultados.innerHTML = "<p>No encontramos resultados reutilizables. Prueba con otra búsqueda.</p>"; return; } resultados.innerHTML = items.map((r, i) => `<button type="button" class="resultado-imagen" data-resultado="${i}"><img src="${escapeHtml(r.thumbnail || r.url)}" alt="" loading="lazy"><span>${escapeHtml(r.title || "Imagen sin título")}</span><small>${escapeHtml(r.creator || "Autor no indicado")} · ${(r.license || "").toUpperCase()}</small></button>`).join(""); resultados.querySelectorAll("button").forEach((b) => b.onclick = () => usarResultado(items[Number(b.dataset.resultado)])); } catch (error) { resultados.innerHTML = `<p>No fue posible conectar el banco ahora. <a href="https://openverse.org/search/image?q=${encodeURIComponent(q)}" target="_blank" rel="noreferrer">Abrir esta búsqueda en Openverse</a>.</p>`; } };
    buscador.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); document.getElementById("buscar-imagen").click(); } });
    const datos = () => ({ nota: sel.value, formato: formato.value, duracion: duracion.value, escenas, fecha: new Date().toISOString() });
    document.getElementById("reel-reproducir").onclick = () => { clearInterval(temporizador); activa = 0; render(); temporizador = setInterval(() => { activa = (activa + 1) % escenas.length; render(); }, Number(duracion.value) * 1000); mensaje.textContent = `Vista previa de ${escenas.length} escenas en reproducción.`; };
    document.getElementById("reel-guardar").onclick = () => { localStorage.setItem("kitus-reel-proyecto", JSON.stringify(datos())); mensaje.textContent = "Proyecto guardado en este navegador."; };
document.getElementById("reel-guion").onclick = () => { const blob = new Blob([JSON.stringify(datos(), null, 2)], { type: "application/json" }), a = document.createElement("a"); a.href = URL.createObjectURL(blob); a.download = "reel-kitus.json"; a.click(); URL.revokeObjectURL(a.href); mensaje.textContent = "Guion y créditos descargados."; };
    const cargarParaExportar = (url) => new Promise((ok) => { if (!url) return ok(null); const img = new Image(); img.crossOrigin = "anonymous"; img.onload = () => ok(img); img.onerror = () => ok(null); img.src = url; });
    const descargarLammina = async (escena, indice) => { const medidas = { reel:[1080,1920], retrato:[1080,1350], cuadrado:[1080,1080], horizontal:[1080,566] }[formato.value]; const [ancho, alto] = medidas, canvas = document.createElement("canvas"), ctx = canvas.getContext("2d"); canvas.width = ancho; canvas.height = alto; ctx.fillStyle = "#171414"; ctx.fillRect(0,0,ancho,alto); const imagen = await cargarParaExportar(escena.imagen?.url); if (imagen) { const escala = Math.max(ancho/imagen.width, alto/imagen.height), w=imagen.width*escala, h=imagen.height*escala; ctx.drawImage(imagen,(ancho-w)/2,(alto-h)/2,w,h); } const velo=ctx.createLinearGradient(0,0,0,alto); velo.addColorStop(0,"rgba(0,0,0,.12)"); velo.addColorStop(1,"rgba(0,0,0,.92)"); ctx.fillStyle=velo; ctx.fillRect(0,0,ancho,alto); const margen=Math.round(ancho*.085), limite=ancho-margen*2, base=alto-Math.round(alto*.3); ctx.fillStyle="#f2a29a"; ctx.font=`800 ${Math.round(ancho*.035)}px Arial`; ctx.fillText(escena.etiqueta||"KITUS",margen,base-Math.round(ancho*.08)); const palabras=(escena.texto||"").split(/\s+/), lineas=[]; let linea=""; const tam=Math.round(ancho*(formato.value==="horizontal"?.06:.075)); ctx.font=`700 ${tam}px Georgia`; palabras.forEach((p)=>{const prueba=`${linea}${linea?" ":""}${p}`;if(ctx.measureText(prueba).width>limite&&linea){lineas.push(linea);linea=p;}else linea=prueba;});if(linea)lineas.push(linea); ctx.fillStyle="#fff"; lineas.slice(0,8).forEach((l,i)=>ctx.fillText(l,margen,base+i*Math.round(tam*1.04))); ctx.font=`700 ${Math.round(ancho*.027)}px Arial`; ctx.fillText(`${String(indice+1).padStart(2,"0")} · KITUS.CL`,margen,alto-margen); return canvas; };
    document.getElementById("reel-descargar-laminas").onclick = async () => { mensaje.textContent = "Preparando las láminas PNG…"; for (let i=0;i<escenas.length;i+=1) { const canvas=await descargarLammina(escenas[i],i); const a=document.createElement("a"); a.href=canvas.toDataURL("image/png"); a.download=`kitus-carrusel-${String(i+1).padStart(2,"0")}.png`; a.click(); } mensaje.textContent = "Láminas descargadas. Súbelas en ese orden como carrusel de Instagram."; };
    document.getElementById("reel-render").onclick = () => mensaje.textContent = "El proyecto está listo. La exportación MP4 se activará al conectar el renderizador de video.";
    completarNota();
  </script>
</Base>

<style>
