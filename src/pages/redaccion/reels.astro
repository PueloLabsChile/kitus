---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const notas = (await getCollection("articulos", ({ data }) => !data.borrador))
  .sort((a, b) => +new Date(b.data.fechaIncorporacion || b.data.fecha) - +new Date(a.data.fechaIncorporacion || a.data.fecha))
  .slice(0, 40);
---
<Base titulo="Constructor de reels" activa="redaccion">
  <main class="contenedor reels-editor">
    <header class="reels-editor__cab">
      <div><p class="kicker">Mesa audiovisual</p><h1>Constructor de reels</h1><p>Arma una secuencia vertical de cinco imágenes —o las que necesites— desde una nota de Kitus.</p></div>
      <a href="/redaccion/redes/">Volver a publicaciones</a>
    </header>

    <section class="reels-editor__nota">
      <label for="reel-nota">Nota de origen</label>
      <select id="reel-nota">
        {notas.map((nota) => <option value={nota.slug} data-bajada={nota.data.bajada} data-imagen={nota.data.portada || ""}>{nota.data.titulo}</option>)}
      </select>
      <small>La fuente y el enlace a Kitus se conservarán en el cierre del reel.</small>
    </section>

    <section class="reels-editor__mesa">
      <form class="reels-editor__controles" id="reel-form">
        <div class="reels-editor__pasos" id="escena-tabs" aria-label="Escenas del reel"></div>
        <button class="agregar-escena" type="button" id="agregar-escena">+ Añadir escena</button>
        <fieldset><legend id="escena-nombre">Escena</legend>
          <label>Texto principal<textarea id="escena-texto" rows="4" maxlength="180"></textarea></label>
          <label>Etiqueta<input id="escena-etiqueta" maxlength="36" value="ANÁLISIS KITUS" /></label>
          <div class="reels-editor__imagen-titulo"><strong>Imagen de esta escena</strong><small>Una imagen por escena, con crédito editorial.</small></div>
          <label class="carga-local">Subir desde el equipo<input id="escena-imagen" type="file" accept="image/jpeg,image/png,image/webp" /></label>
          <section class="buscador-imagenes" aria-label="Buscador profesional de imágenes">
            <div><p class="buscador-imagenes__titulo">Buscar imágenes profesionales</p><p>Banco editorial Openverse: selecciona imágenes con licencia visible y atribución incorporada.</p></div>
            <div class="buscador-imagenes__barra"><input id="buscador-imagen" type="search" placeholder="Ej.: elecciones África, protesta, tribunal" /><button type="button" id="buscar-imagen">Buscar</button></div>
            <p class="buscador-imagenes__ayuda">Filtramos resultados reutilizables (CC0, PDM, CC BY y CC BY-SA). Verifica la licencia antes de publicar.</p>
            <div class="buscador-imagenes__resultados" id="resultados-imagenes" aria-live="polite"></div>
          </section>
          <p class="credito-imagen" id="credito-imagen">Aún no hay imagen seleccionada.</p>
          <label>Duración por escena<select id="reel-duracion"><option value="2.5">2,5 segundos</option><option value="3" selected>3 segundos</option><option value="4">4 segundos</option></select></label>
        </fieldset>
        <div class="reels-editor__acciones"><button type="button" id="reel-reproducir">Previsualizar</button><button type="button" class="secundario" id="reel-guardar">Guardar proyecto</button><button type="button" class="secundario" id="reel-guion">Descargar guion</button><button type="button" id="reel-render">Solicitar MP4</button></div>
        <p id="reel-mensaje" role="status"></p>
      </form>

      <aside class="reels-editor__vista"><div class="reel-marco" aria-label="Vista previa vertical del reel"><div class="reel-escena" id="vista-escena"><div class="reel-escena__imagen" id="vista-imagen"></div><div class="reel-escena__velo"></div><div class="reel-escena__contenido"><span id="vista-etiqueta">ANÁLISIS KITUS</span><h2 id="vista-texto">Selecciona una nota</h2><small id="vista-pie">01 · kitus.cl</small></div></div></div><p class="reels-editor__formato">1080 × 1920 · 9:16 · Instagram Reel</p></aside>
    </section>
    <section class="reels-editor__nota-tecnica"><strong>Uso editorial</strong><p>El buscador muestra autor y licencia de cada imagen seleccionada. El proyecto guarda esos créditos; antes de exportar, confirma que la licencia corresponde al uso de Kitus.</p></section>
  </main>

  <script>
    const sel = document.getElementById("reel-nota");
    const tabs = document.getElementById("escena-tabs"), texto = document.getElementById("escena-texto"), etiqueta = document.getElementById("escena-etiqueta"), archivo = document.getElementById("escena-imagen"), duracion = document.getElementById("reel-duracion"), mensaje = document.getElementById("reel-mensaje"), credito = document.getElementById("credito-imagen"), resultados = document.getElementById("resultados-imagenes"), buscador = document.getElementById("buscador-imagen"), vistaImagen = document.getElementById("vista-imagen"), vistaTexto = document.getElementById("vista-texto"), vistaEtiqueta = document.getElementById("vista-etiqueta"), vistaPie = document.getElementById("vista-pie");
    let activa = 0, temporizador;
    const escenas = [
      { nombre: "Portada", texto: "", etiqueta: "ANÁLISIS KITUS", imagen: null },
      { nombre: "Contexto", texto: "", etiqueta: "CONTEXTO", imagen: null },
      { nombre: "Dato clave", texto: "", etiqueta: "EN CIFRAS", imagen: null },
      { nombre: "Mirada", texto: "", etiqueta: "ANÁLISIS", imagen: null },
      { nombre: "Cierre", texto: "Lee la nota completa en kitus.cl", etiqueta: "KITUS", imagen: null }
    ];
    const escapeHtml = (v) => String(v || "").replace(/[&<>'"]/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;","\"":"&quot;"})[c]);
    const notaActual = () => sel.selectedOptions[0];
    const imagenFondo = (imagen) => imagen ? `linear-gradient(rgba(8,8,8,.18),rgba(8,8,8,.74)),url("${imagen.url}")` : "linear-gradient(145deg,#4e1a14,#161616 62%,#c53d2d)";
    const renderTabs = () => { tabs.innerHTML = escenas.map((e, i) => `<button type="button" class="${i === activa ? "activo" : ""}" data-escena="${i}">${String(i + 1).padStart(2,"0")} ${escapeHtml(e.nombre)}</button>`).join(""); tabs.querySelectorAll("button").forEach((b) => b.onclick = () => { activa = Number(b.dataset.escena); render(); }); };
    const render = () => {
      const e = escenas[activa];
      document.getElementById("escena-nombre").textContent = `${String(activa + 1).padStart(2,"0")} · ${e.nombre}`;
      texto.value = e.texto; etiqueta.value = e.etiqueta;
      vistaTexto.textContent = e.texto || "Escribe el mensaje de esta escena";
      vistaEtiqueta.textContent = e.etiqueta || "KITUS";
      vistaPie.textContent = `${String(activa + 1).padStart(2,"0")} · kitus.cl`;
      vistaImagen.style.backgroundImage = imagenFondo(e.imagen);
      credito.textContent = e.imagen ? `Crédito: ${e.imagen.credito}. Licencia: ${e.imagen.licencia}.` : "Aún no hay imagen seleccionada para esta escena.";
      renderTabs();
    };
    const completarNota = () => { const o = notaActual(); escenas[0].texto = o.textContent.trim(); escenas[1].texto = o.dataset.bajada || "Explica aquí el contexto principal de la noticia."; escenas[2].texto = "Destaca el dato que cambia la lectura de la historia."; escenas[3].texto = "Aporta una mirada editorial breve y precisa."; if (o.dataset.imagen) escenas[0].imagen = { url: o.dataset.imagen, credito: "Portada de la nota de Kitus", licencia: "Uso editorial Kitus" }; render(); };
    tabs.addEventListener("click", () => {});
    document.getElementById("agregar-escena").onclick = () => { escenas.push({ nombre: `Escena ${escenas.length + 1}`, texto: "", etiqueta: "KITUS", imagen: null }); activa = escenas.length - 1; render(); };
    [texto, etiqueta].forEach((el) => el.oninput = () => { escenas[activa][el === texto ? "texto" : "etiqueta"] = el.value; render(); });
    sel.onchange = completarNota;
    archivo.onchange = () => { const f = archivo.files[0]; if (!f) return; const r = new FileReader(); r.onload = () => { escenas[activa].imagen = { url: r.result, credito: "Archivo subido por la redacción", licencia: "Completar crédito antes de publicar" }; render(); }; r.readAsDataURL(f); };
    const usarResultado = (r) => { escenas[activa].imagen = { url: r.url || r.thumbnail, credito: `${r.creator || "Autor no indicado"} · ${r.source || "Openverse"}`, licencia: `${(r.license || "licencia por verificar").toUpperCase()}${r.license_version ? " " + r.license_version : ""}`, enlace: r.foreign_landing_url || r.url }; render(); mensaje.textContent = "Imagen y atribución añadidas a esta escena."; };
    document.getElementById("buscar-imagen").onclick = async () => { const q = buscador.value.trim(); if (!q) { mensaje.textContent = "Escribe qué imagen necesitas buscar."; return; } resultados.innerHTML = "<p>Buscando imágenes con licencia…</p>"; try { const respuesta = await fetch(`https://api.openverse.org/v1/images/?q=${encodeURIComponent(q)}&page_size=20`); if (!respuesta.ok) throw new Error("Servicio no disponible"); const data = await respuesta.json(); const permitidas = new Set(["cc0", "pdm", "by", "by-sa"]); const items = (data.results || []).filter((r) => permitidas.has(String(r.license || "").toLowerCase())).slice(0, 12); if (!items.length) { resultados.innerHTML = "<p>No encontramos resultados reutilizables. Prueba con otra búsqueda.</p>"; return; } resultados.innerHTML = items.map((r, i) => `<button type="button" class="resultado-imagen" data-resultado="${i}"><img src="${escapeHtml(r.thumbnail || r.url)}" alt="" loading="lazy"><span>${escapeHtml(r.title || "Imagen sin título")}</span><small>${escapeHtml(r.creator || "Autor no indicado")} · ${(r.license || "").toUpperCase()}</small></button>`).join(""); resultados.querySelectorAll("button").forEach((b) => b.onclick = () => usarResultado(items[Number(b.dataset.resultado)])); } catch (error) { resultados.innerHTML = `<p>No fue posible conectar el banco ahora. <a href="https://openverse.org/search/image?q=${encodeURIComponent(q)}" target="_blank" rel="noreferrer">Abrir esta búsqueda en Openverse</a>.</p>`; } };
    buscador.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); document.getElementById("buscar-imagen").click(); } });
    const datos = () => ({ nota: sel.value, duracion: duracion.value, escenas, fecha: new Date().toISOString() });
    document.getElementById("reel-reproducir").onclick = () => { clearInterval(temporizador); activa = 0; render(); temporizador = setInterval(() => { activa = (activa + 1) % escenas.length; render(); }, Number(duracion.value) * 1000); mensaje.textContent = `Vista previa de ${escenas.length} escenas en reproducción.`; };
    document.getElementById("reel-guardar").onclick = () => { localStorage.setItem("kitus-reel-proyecto", JSON.stringify(datos())); mensaje.textContent = "Proyecto guardado en este navegador."; };
    document.getElementById("reel-guion").onclick = () => { const blob = new Blob([JSON.stringify(datos(), null, 2)], { type: "application/json" }), a = document.createElement("a"); a.href = URL.createObjectURL(blob); a.download = "reel-kitus.json"; a.click(); URL.revokeObjectURL(a.href); mensaje.textContent = "Guion y créditos descargados."; };
    document.getElementById("reel-render").onclick = () => mensaje.textContent = "El proyecto está listo. La exportación MP4 se activará al conectar el renderizador de video.";
    completarNota();
  </script>
</Base>

<style>
.reels-editor{padding-block:3rem 5rem}.reels-editor__cab{display:flex;justify-content:space-between;gap:2rem;align-items:end;padding-bottom:1.4rem;border-bottom:2px solid var(--tinta)}.reels-editor__cab h1{margin:.25rem 0;font-size:clamp(2.3rem,5vw,4.4rem)}.reels-editor__cab p:last-child{max-width:45rem;margin:0;color:var(--gris);font:1rem/1.6 var(--sans)}.reels-editor__cab>a{font:700 .75rem var(--sans);color:var(--tinta);white-space:nowrap}.reels-editor__nota{padding:1rem 0;border-bottom:1px solid var(--linea);font:700 .76rem var(--sans);letter-spacing:.04em;text-transform:uppercase}.reels-editor__nota select{max-width:42rem;margin-left:1rem;padding:.55rem;border:1px solid var(--linea);background:#fff;font:400 .9rem var(--sans)}.reels-editor__nota small{display:block;margin-top:.7rem;color:var(--gris);font:400 .75rem var(--sans);letter-spacing:0;text-transform:none}.reels-editor__mesa{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.72fr);gap:3.5rem;padding-top:2rem}.reels-editor__pasos{display:flex;gap:.35rem;flex-wrap:wrap;border-bottom:1px solid var(--linea);padding-bottom:1rem;margin-bottom:.7rem}.reels-editor__pasos button{border:0;background:transparent;color:var(--gris);padding:.35rem .15rem;margin-right:.8rem;font:700 .7rem var(--sans);letter-spacing:.04em;cursor:pointer}.reels-editor__pasos button.activo{color:var(--rojo);border-bottom:2px solid var(--rojo)}.agregar-escena{margin:0 0 1.3rem;border:1px solid var(--tinta);background:#fff;padding:.5rem .7rem;color:var(--tinta);font:700 .68rem var(--sans);letter-spacing:.04em;text-transform:uppercase;cursor:pointer}.reels-editor fieldset{margin:0;padding:0;border:0}.reels-editor legend{margin-bottom:1rem;font:700 1.35rem var(--serif)}.reels-editor label{display:block;margin:1rem 0;font:700 .72rem var(--sans);letter-spacing:.05em;text-transform:uppercase}.reels-editor textarea,.reels-editor input,.reels-editor select{display:block;box-sizing:border-box;width:100%;margin-top:.45rem;padding:.75rem;border:1px solid var(--linea);background:#fff;color:var(--tinta);font:400 .95rem/1.45 var(--sans);letter-spacing:0;text-transform:none}.reels-editor__imagen-titulo{margin-top:1.4rem}.reels-editor__imagen-titulo strong{font:700 .8rem var(--sans);text-transform:uppercase}.reels-editor__imagen-titulo small{display:block;margin-top:.3rem;color:var(--gris);font:.78rem var(--sans)}.carga-local{max-width:23rem}.buscador-imagenes{margin:1.2rem 0;padding:1rem;border:1px solid var(--linea);background:#f3f0ea}.buscador-imagenes__titulo{margin:0 0 .25rem;font:700 1rem var(--serif)}.buscador-imagenes p{margin:.15rem 0;color:var(--gris);font:.78rem/1.45 var(--sans)}.buscador-imagenes__barra{display:flex;gap:.45rem;margin-top:.8rem}.buscador-imagenes__barra input{margin:0}.buscador-imagenes__barra button{border:1px solid var(--tinta);background:var(--tinta);color:#fff;padding:.5rem .8rem;font:700 .67rem var(--sans);text-transform:uppercase;cursor:pointer}.buscador-imagenes__ayuda{font-size:.7rem!important}.buscador-imagenes__resultados{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem;margin-top:.8rem}.resultado-imagen{min-width:0;padding:0;border:1px solid #d1cbc2;background:#fff;text-align:left;cursor:pointer}.resultado-imagen img{display:block;width:100%;aspect-ratio:1.2/1;object-fit:cover}.resultado-imagen span,.resultado-imagen small{display:block;padding:.35rem .4rem;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font:.65rem var(--sans)}.resultado-imagen small{padding-top:0;color:var(--gris);font-size:.58rem}.credito-imagen{padding:.7rem;border-left:3px solid var(--rojo);background:#fff6f4;color:var(--gris);font:.76rem/1.45 var(--sans)}.reels-editor__acciones{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1.6rem}.reels-editor__acciones button{border:1px solid var(--tinta);background:var(--tinta);color:#fff;padding:.7rem .85rem;font:700 .7rem var(--sans);letter-spacing:.04em;text-transform:uppercase;cursor:pointer}.reels-editor__acciones .secundario{background:transparent;color:var(--tinta)}#reel-mensaje{min-height:1.3rem;color:var(--rojo);font:.78rem var(--sans)}.reels-editor__vista{justify-self:center;width:min(100%,20rem)}.reel-marco{position:relative;aspect-ratio:9/16;overflow:hidden;background:#0d0d0d;box-shadow:0 16px 40px rgba(0,0,0,.2)}.reel-escena{position:absolute;inset:0;display:flex;align-items:flex-end;color:#fff}.reel-escena__imagen{position:absolute;inset:0;background:linear-gradient(145deg,#4e1a14,#161616 62%,#c53d2d);background-size:cover;background-position:center}.reel-escena__velo{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.1),rgba(0,0,0,.88))}.reel-escena__contenido{position:relative;padding:1.4rem}.reel-escena span{color:#f2a29a;font:800 .62rem var(--sans);letter-spacing:.12em}.reel-escena h2{margin:.6rem 0 1.3rem;font-size:2rem;line-height:.95}.reel-escena small{font:700 .62rem var(--sans);letter-spacing:.08em;text-transform:uppercase}.reels-editor__formato{margin:.7rem 0 0;text-align:center;color:var(--gris);font:.66rem var(--sans);letter-spacing:.07em;text-transform:uppercase}.reels-editor__nota-tecnica{display:flex;gap:1rem;margin-top:3rem;padding:1rem;border-top:2px solid var(--tinta);border-bottom:1px solid var(--linea);font:.82rem/1.5 var(--sans)}.reels-editor__nota-tecnica strong{white-space:nowrap;text-transform:uppercase;letter-spacing:.06em}.reels-editor__nota-tecnica p{margin:0;color:var(--gris)}@media(max-width:720px){.reels-editor__cab,.reels-editor__mesa,.reels-editor__nota-tecnica{display:block}.reels-editor__cab>a{display:inline-block;margin-top:1rem}.reels-editor__nota select{display:block;width:100%;max-width:none;margin:.6rem 0 0}.reels-editor__vista{margin:2.5rem auto}.reels-editor__nota-tecnica strong{display:block;margin-bottom:.5rem}.buscador-imagenes__resultados{grid-template-columns:repeat(2,1fr)}}
</style>