---
import Base from "../../layouts/Base.astro";
---
<Base titulo="Nuevo borrador" activa="redaccion"><main class="contenedor borrador"><header class="borrador__cab"><div><p class="kicker">Sala de redaccion</p><h1>Nuevo borrador</h1><p>Escribe primero. La asistencia IA y la revision editorial entran despues.</p></div><a href="/redaccion/mis-articulos/">Volver a mis articulos</a></header><form class="borrador__form" id="borrador-form"><label>Seccion<select id="seccion"><option>Internacional</option><option>Politica</option><option>Economia</option><option>Derechos</option><option>Africa y Sur Global</option><option>Cultura</option></select></label><label class="borrador__ancho">Titular<input id="titulo-borrador" required placeholder="Escribe un titular informativo"/></label><label class="borrador__ancho">Bajada<textarea id="bajada-borrador" rows="3" placeholder="Explica lo esencial de la nota en dos o tres lineas"></textarea></label><fieldset class="borrador__imagen borrador__ancho"><legend>Imagen de portada</legend><p class="borrador__ayuda">Sube una fotografía propia o busca una imagen reutilizable. La fuente y licencia se guardan con el borrador.</p><div class="borrador__imagen-opciones"><label class="borrador__subir">Subir foto propia<input id="imagen-archivo" type="file" accept="image/jpeg,image/png,image/webp"/><span>JPG, PNG o WebP</span></label><div class="borrador__buscar"><label for="imagen-busqueda">Buscar en Wikimedia Commons</label><div><input id="imagen-busqueda" type="search" placeholder="Ej.: manifestación en Chile"/><button id="imagen-buscar" type="button">Buscar</button></div></div></div><div id="imagen-resultados" class="imagen-resultados" aria-live="polite"></div><figure id="imagen-seleccion" class="imagen-seleccion" hidden><img id="imagen-vista" alt=""/><figcaption><strong id="imagen-origen"></strong><span id="imagen-credito"></span></figcaption><button id="imagen-quitar" type="button">Quitar imagen</button></figure></fieldset><label class="borrador__ancho">Texto<textarea id="texto-borrador" rows="15" placeholder="Comienza tu articulo. Registra las fuentes antes de enviarlo a revision."></textarea></label><label class="borrador__ancho">Fuentes y enlaces<textarea id="fuentes-borrador" rows="4" placeholder="Una fuente por linea"></textarea></label><label class="borrador__ancho">Encargo para IA<textarea id="prompt-ia" rows="4" placeholder="Indica tema, enfoque, datos y tono. Ej.: redacta una nota de 600 palabras sobre…"></textarea><span class="borrador__campo-ayuda">La IA propone un borrador; debes verificar fuentes y editar antes de enviarlo a revisión.</span></label><div class="borrador__acciones"><button type="button" id="asistente">Generar con IA</button><button type="submit">Guardar borrador</button><button type="button" id="enviar-revision">Enviar a revision</button><button type="button" id="publicar-directo">Publicar directamente</button><button type="button" id="eliminar-borrador">Eliminar</button></div><p id="borrador-mensaje" role="status"></p></form></main><script>
const sesion=JSON.parse(localStorage.getItem("kitus-sesion-prueba")||"null");if(!sesion){window.location.href="/acceso/";}document.getElementById("borrador-form").addEventListener("submit",(e)=>{e.preventDefault();const datos={titulo:document.getElementById("titulo-borrador").value,seccion:document.getElementById("seccion").value,bajada:document.getElementById("bajada-borrador").value,texto:document.getElementById("texto-borrador").value,fuentes:document.getElementById("fuentes-borrador").value,imagen:imagenPortada,fecha:new Date().toLocaleDateString("es-CL")};localStorage.setItem("kitus-borrador-prueba",JSON.stringify(datos));document.getElementById("borrador-mensaje").textContent="Borrador guardado localmente. Ya puedes volver a Mis articulos."});document.getElementById("publicar-directo").addEventListener("click",()=>{const titulo=document.getElementById("titulo-borrador");if(!titulo.value){titulo.focus();document.getElementById("borrador-mensaje").textContent="Agrega un titular antes de publicar.";return}const nota={titulo:titulo.value,seccion:document.getElementById("seccion").value,bajada:document.getElementById("bajada-borrador").value,texto:document.getElementById("texto-borrador").value,imagen:imagenPortada,fecha:new Date().toLocaleDateString("es-CL")};localStorage.setItem("kitus-publicacion-prueba",JSON.stringify(nota));localStorage.removeItem("kitus-borrador-prueba");window.location.href="/redaccion/publicado/";});document.getElementById("eliminar-borrador").addEventListener("click",()=>{if(confirm("Eliminar este borrador de prueba?")){document.getElementById("borrador-form").reset();localStorage.removeItem("kitus-borrador-prueba");localStorage.removeItem("kitus-borrador-estado");document.getElementById("borrador-mensaje").textContent="Borrador eliminado."}});document.getElementById("enviar-revision").addEventListener("click",async()=>{const titulo=document.getElementById("titulo-borrador");if(!titulo.value){titulo.focus();document.getElementById("borrador-mensaje").textContent="Agrega un titular antes de enviar a revisión.";return}const mensaje=document.getElementById("borrador-mensaje");try{const r=await fetch("/api/revision.php",{method:"POST",body:new URLSearchParams({action:"submit",titulo:titulo.value,seccion:document.getElementById("seccion").value,bajada:document.getElementById("bajada-borrador").value,texto:document.getElementById("texto-borrador").value,fuentes:document.getElementById("fuentes-borrador").value})});const j=await r.json();if(!r.ok)throw new Error(j.error);mensaje.textContent="Artículo enviado a revisión editorial.";}catch(e){mensaje.textContent=e.message||"No fue posible enviar la nota.";}});document.getElementById("asistente").addEventListener("click",()=>{const t=document.getElementById("titulo-borrador");if(!t.value){t.focus();document.getElementById("borrador-mensaje").textContent="Escribe un titular para preparar sugerencias de estructura.";}else{document.getElementById("borrador-mensaje").textContent="Asistente listo: en la integracion real aqui se generaran una estructura y preguntas de verificacion, sin alterar tus fuentes.";}});
const imagen$=(id)=>document.getElementById(id);let imagenPortada=null;const limpiarCredito=(texto)=>String(texto||"").replace(/<[^>]*>/g,"").replace(/\s+/g," ").trim();const mostrarImagen=(datos)=>{imagenPortada=datos;imagen$("imagen-vista").src=datos.url;imagen$("imagen-vista").alt=datos.descripcion||"Imagen de portada seleccionada";imagen$("imagen-origen").textContent=datos.origen;imagen$("imagen-credito").textContent=datos.credito;imagen$("imagen-seleccion").hidden=false;};const quitarImagen=()=>{imagenPortada=null;imagen$("imagen-archivo").value="";imagen$("imagen-seleccion").hidden=true;};imagen$("imagen-archivo").addEventListener("change",(evento)=>{const archivo=evento.target.files?.[0];if(!archivo)return;if(archivo.size>8*1024*1024){document.getElementById("borrador-mensaje").textContent="La foto debe pesar menos de 8 MB.";evento.target.value="";return}const lector=new FileReader();lector.onload=()=>mostrarImagen({url:String(lector.result),origen:"Fotografía propia",credito:"Crédito pendiente de completar"});lector.readAsDataURL(archivo);});imagen$("imagen-quitar").addEventListener("click",quitarImagen);let busquedaImagen="",siguientePagina="",totalImagenes=0,cargandoImagenes=false;const crearResultado=(pagina)=>{const info=pagina.imageinfo?.[0];if(!info?.thumburl)return;const meta=info.extmetadata||{},autor=limpiarCredito(meta.Artist?.value)||"Autor no indicado",licencia=limpiarCredito(meta.LicenseShortName?.value)||"Licencia por revisar",boton=document.createElement("button"),miniatura=document.createElement("img"),texto=document.createElement("span");boton.type="button";boton.className="imagen-resultado";miniatura.src=info.thumburl;miniatura.alt="";miniatura.loading="lazy";texto.textContent=pagina.title.replace(/^File:/,"");boton.append(miniatura,texto);boton.addEventListener("click",()=>{mostrarImagen({url:info.url,descripcion:pagina.title.replace(/^File:/,""),origen:"Wikimedia Commons",credito:`${autor} · ${licencia}`});});imagen$("imagen-resultados").append(boton);};const cargarImagenes=async(reiniciar=false)=>{const contenedor=imagen$("imagen-resultados");if(cargandoImagenes||(!reiniciar&&(!siguientePagina||totalImagenes>=1000)))return;cargandoImagenes=true;if(reiniciar){busquedaImagen=imagen$("imagen-busqueda").value.trim();siguientePagina="";totalImagenes=0;contenedor.replaceChildren();}if(!busquedaImagen){imagen$("imagen-busqueda").focus();cargandoImagenes=false;return}const estado=document.createElement("p");estado.className="imagen-resultados__estado";estado.textContent=totalImagenes?"Cargando más imágenes…":"Buscando imágenes reutilizables…";contenedor.append(estado);try{const pagina=siguientePagina?`&gsroffset=${encodeURIComponent(siguientePagina)}`:"";const url=`https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrsearch=${encodeURIComponent(busquedaImagen)}&gsrnamespace=6&gsrlimit=50${pagina}&prop=imageinfo&iiprop=url%7Cextmetadata&iiurlwidth=360&format=json&origin=*`;const respuesta=await fetch(url);if(!respuesta.ok)throw new Error();const json=await respuesta.json();estado.remove();const paginas=Object.values(json.query?.pages||{}).sort((a,b)=>(a.index||0)-(b.index||0));paginas.slice(0,1000-totalImagenes).forEach(crearResultado);totalImagenes+=paginas.length;siguientePagina=json.continue?.gsroffset||"";if(!totalImagenes){contenedor.textContent="No encontramos imágenes. Prueba con otras palabras."}else if(totalImagenes<1000&&siguientePagina){const aviso=document.createElement("p");aviso.className="imagen-resultados__estado";aviso.textContent=`${totalImagenes} imágenes disponibles. Desplázate para cargar más.`;contenedor.append(aviso);}}catch{estado.remove();if(!totalImagenes)contenedor.textContent="No fue posible conectar con el buscador. Intenta nuevamente.";}finally{cargandoImagenes=false;}};imagen$("imagen-buscar").addEventListener("click",()=>cargarImagenes(true));imagen$("imagen-resultados").addEventListener("scroll",(evento)=>{const panel=evento.currentTarget;if(panel.scrollTop+panel.clientHeight>=panel.scrollHeight-80)cargarImagenes();});imagen$("imagen-busqueda").addEventListener("keydown",(evento)=>{if(evento.key==="Enter"){evento.preventDefault();imagen$("imagen-buscar").click();}});document.getElementById("asistente").addEventListener("click",async()=>{const boton=document.getElementById("asistente"),prompt=document.getElementById("prompt-ia").value.trim(),mensaje=document.getElementById("borrador-mensaje");if(!prompt){document.getElementById("prompt-ia").focus();mensaje.textContent="Describe el encargo que quieres generar.";return}boton.disabled=true;boton.textContent="Generando…";mensaje.textContent="La IA está preparando un borrador. Verifica siempre los datos y las fuentes.";try{const respuesta=await fetch("/api/generar-articulo.php",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded;charset=UTF-8"},body:new URLSearchParams({prompt,seccion:document.getElementById("seccion").value,titulo:document.getElementById("titulo-borrador").value,bajada:document.getElementById("bajada-borrador").value,fuentes:document.getElementById("fuentes-borrador").value})});const resultado=await respuesta.json();if(!respuesta.ok)throw new Error(resultado.error||"No fue posible generar el borrador.");document.getElementById("titulo-borrador").value=resultado.titulo||"";document.getElementById("bajada-borrador").value=resultado.bajada||"";document.getElementById("texto-borrador").value=resultado.texto||"";mensaje.textContent="Borrador generado. Revísalo, contrasta las fuentes y edítalo antes de enviarlo a revisión.";}catch(error){mensaje.textContent=error.message||"No fue posible conectar con la IA.";}finally{boton.disabled=false;boton.textContent="Generar con IA";}});</script></Base>