---
import Base from "../../layouts/Base.astro";
---
<Base titulo="Redes sociales" activa="redaccion">
  <main class="contenedor redes">
    <header class="redes__cab">
      <div><p class="kicker">Jefatura editorial</p><h1>Publicacion social</h1><p>Prepara una salida para Instagram a partir de una nota aprobada. La publicacion siempre conserva su enlace en Kitus.</p></div>
      <a href="/redaccion/gestion/">Volver a gestion</a>
    </header>
    <section class="redes__estado">
      <div><span class="redes__punto"></span><div><strong>Instagram de Kitus</strong><small id="estado-cuenta">Conexion pendiente de Meta</small></div></div>
      <button type="button" id="conectar-instagram">Conectar cuenta profesional</button>
    </section>
    <section class="redes__mesa">
      <form id="redes-form">
        <p class="kicker">Nueva publicacion</p><h2>Editar antes de enviar</h2>
        <label>Nota de origen<select id="nota-origen"><option value="">Selecciona una nota aprobada</option><option value="Europa en movimiento: claves para leer la jornada desde Madrid">Europa en movimiento: claves para leer la jornada desde Madrid</option><option value="Actualidad de Africa y el Sur Global">Actualidad de Africa y el Sur Global</option></select></label>
        <label>Texto para Instagram<textarea id="texto-instagram" rows="8" maxlength="2200" placeholder="Escribe una bajada clara, agrega contexto y termina con el enlace a la nota."></textarea><small><span id="contador">0</span>/2200 caracteres</small></label>
        <label>Imagen vertical<input id="imagen-instagram" type="file" accept="image/jpeg,image/png,image/webp" /><small>Formato recomendado 4:5. Imagen obligatoria antes de publicar.</small></label>
        <label>Enlace de Kitus<input id="enlace-instagram" type="url" placeholder="https://kitus.cl/articulo/..." /></label>
        <div class="redes__acciones"><button type="button" id="guardar-redes">Guardar como pendiente</button><button type="submit">Enviar a Instagram</button></div>
        <p id="redes-mensaje" role="status"></p>
      </form>
      <aside class="redes__preview"><p class="kicker">Vista previa</p><div class="redes__post"><header><div class="redes__avatar">K</div><strong>kitus</strong><span>...</span></header><div class="redes__imagen" id="preview-imagen"><span>Imagen de la nota</span></div><div class="redes__iconos">♡ &nbsp; ◯ &nbsp; ➤ <span>⌑</span></div><div class="redes__copy"><strong>kitus</strong> <span id="preview-texto">El texto de la publicacion aparecera aqui.</span></div><a id="preview-enlace" href="#" hidden>Leer nota completa en Kitus</a></div></aside>
    </section>
    <section class="redes__criterios"><div><strong>01</strong><p>Solo una nota revisada puede salir a redes.</p></div><div><strong>02</strong><p>La imagen debe tener credito y autorizacion de uso.</p></div><div><strong>03</strong><p>La salida real se registra con fecha, responsable y enlace.</p></div></section>
  </main>
  <script>
    const sesion=JSON.parse(localStorage.getItem("kitus-sesion-prueba")||"null");if(!sesion||sesion.rol!=="jefatura")window.location.href="/acceso/";
    const texto=document.getElementById("texto-instagram"),contador=document.getElementById("contador"),previo=document.getElementById("preview-texto"),enlace=document.getElementById("enlace-instagram"),previoEnlace=document.getElementById("preview-enlace"),imagen=document.getElementById("imagen-instagram"),previoImagen=document.getElementById("preview-imagen"),mensaje=document.getElementById("redes-mensaje");
    texto.addEventListener("input",()=>{contador.textContent=texto.value.length;previo.textContent=texto.value||"El texto de la publicacion aparecera aqui."});enlace.addEventListener("input",()=>{previoEnlace.hidden=!enlace.value;previoEnlace.href=enlace.value||"#"});imagen.addEventListener("change",()=>{const archivo=imagen.files[0];if(!archivo)return;const lector=new FileReader();lector.onload=()=>{previoImagen.innerHTML="";previoImagen.style.backgroundImage="url('"+lector.result+"')";};lector.readAsDataURL(archivo)});
    document.getElementById("guardar-redes").addEventListener("click",()=>{localStorage.setItem("kitus-instagram-pendiente",JSON.stringify({texto:texto.value,enlace:enlace.value,fecha:new Date().toISOString()}));mensaje.textContent="Publicacion guardada como pendiente de conexion con Instagram.";});
    document.getElementById("redes-form").addEventListener("submit",(e)=>{e.preventDefault();if(!texto.value||!imagen.files[0]||!enlace.value){mensaje.textContent="Agrega texto, imagen y enlace de Kitus antes de enviar.";return}mensaje.textContent="La cuenta aun no esta conectada. Al autorizar Meta, esta publicacion podra enviarse desde aqui.";});document.getElementById("conectar-instagram").addEventListener("click",()=>{mensaje.textContent="Pendiente: autorizar la cuenta profesional mediante Meta Business en el hosting seguro.";});
  </script>
</Base>
<style>
.redes{padding-block:3rem 5rem}.redes__cab{display:flex;justify-content:space-between;gap:2rem;align-items:flex-end;border-bottom:2px solid var(--tinta);padding-bottom:1.5rem}.redes__cab h1{margin:.25rem 0;font-size:clamp(2.1rem,5vw,4rem)}.redes__cab>div>p:last-child{max-width:44rem;margin:0;color:var(--gris);font:1.05rem/1.6 var(--sans)}.redes__cab>a{font:700 .75rem var(--sans);color:var(--tinta);white-space:nowrap}.redes__estado{margin-block:1.5rem;display:flex;justify-content:space-between;align-items:center;border:1px solid var(--linea);padding:1rem 1.2rem}.redes__estado>div{display:flex;align-items:center;gap:.8rem}.redes__estado strong,.redes__estado small{display:block}.redes__estado small{font:400 .77rem var(--sans);color:var(--gris);margin-top:.15rem}.redes__punto{width:.6rem;height:.6rem;border-radius:50%;background:#bf9b44}.redes button{font:700 .72rem var(--sans);padding:.7rem 1rem;border:1px solid var(--tinta);background:var(--tinta);color:#fff;cursor:pointer}.redes__mesa{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:3rem;padding-block:2rem;border-bottom:1px solid var(--linea)}.redes form h2{margin:.25rem 0 1.3rem}.redes label{display:block;font:700 .75rem var(--sans);letter-spacing:.03em;margin:1rem 0}.redes input,.redes select,.redes textarea{display:block;width:100%;box-sizing:border-box;margin-top:.4rem;border:1px solid var(--linea);font:400 .95rem/1.5 var(--sans);padding:.7rem;background:#fff}.redes textarea{resize:vertical}.redes label small{display:block;color:var(--gris);font:400 .7rem var(--sans);margin-top:.35rem}.redes__acciones{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1.2rem}.redes__acciones button:first-child{background:#fff;color:var(--tinta)}#redes-mensaje{font:600 .78rem var(--sans);color:var(--rojo);min-height:1.25rem}.redes__preview{border-left:1px solid var(--linea);padding-left:2rem}.redes__post{max-width:350px;margin:1rem auto;border:1px solid #dbdbdb;background:#fff;font:400 .8rem/1.45 Arial,sans-serif}.redes__post header{display:flex;align-items:center;gap:.6rem;padding:.7rem}.redes__post header span{margin-left:auto}.redes__avatar{width:1.7rem;height:1.7rem;border-radius:50%;display:grid;place-items:center;background:linear-gradient(45deg,#f5b,#f90);color:#fff;font-weight:bold}.redes__imagen{aspect-ratio:1/1;background:#ece8e0;display:grid;place-items:center;background-position:center;background-size:cover;color:#777}.redes__iconos{font-size:1.35rem;padding:.6rem}.redes__iconos span{float:right}.redes__copy,.redes__post>a{display:block;padding:0 .7rem .7rem}.redes__post>a{color:#174f84;text-decoration:none;font-size:.75rem}.redes__criterios{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-top:2rem}.redes__criterios div{display:flex;gap:.7rem}.redes__criterios strong{font:700 1.6rem var(--serif);color:var(--rojo)}.redes__criterios p{margin:0;font:400 .82rem/1.5 var(--sans)}@media(max-width:720px){.redes__cab,.redes__estado{align-items:flex-start;flex-direction:column}.redes__mesa{grid-template-columns:1fr}.redes__preview{border-left:0;border-top:1px solid var(--linea);padding:2rem 0 0}.redes__criterios{grid-template-columns:1fr}}
</style>
