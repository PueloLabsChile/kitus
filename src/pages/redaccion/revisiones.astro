---
import Base from "../../layouts/Base.astro";
import cola from "../../data/cola-rss.json";
const fecha = (valor) => new Intl.DateTimeFormat("es-CL", { dateStyle: "medium", timeStyle: "short" }).format(new Date(valor));
---
<Base titulo="Cola de revision" activa="redaccion">
  <main class="contenedor cola-rss">
    <header><div><p class="kicker">Monitoreo editorial</p><h1>Cola de revision</h1><p>Hallazgos desde fuentes RSS. Ninguno se publica sin una decision de jefatura.</p></div><a href="/redaccion/gestion/">Volver a gestion</a></header>
    <section class="cola-rss__regla"><strong>Revision antes de publicacion</strong><span>El sistema guarda solo titulares, extractos y enlaces de origen.</span></section>
    <section class="cola-rss__lista">{cola.length ? cola.map((nota) => <article><div><p class="kicker">{nota.medio} · {nota.seccion}</p><h2>{nota.titulo}</h2>{nota.resumen && <p>{nota.resumen}</p>}<a href={nota.enlace} target="_blank" rel="noreferrer">Abrir fuente original</a></div><aside><time>{fecha(nota.fecha)}</time><span>{nota.estado}</span><a href={`/redaccion/nuevo-articulo/?fuente=${encodeURIComponent(nota.enlace)}`}>Crear borrador</a></aside></article>) : <article class="cola-rss__vacia"><h2>Aun no hay hallazgos.</h2><p>La tarea programada revisara las fuentes y los depositara aqui para la jefatura.</p></article>}</section>
  </main>
  
<script>fetch("/api/revision.php").then(r=>r.json()).then(({items=[]})=>{const l=document.querySelector(".cola-rss__lista");if(items.length)l.insertAdjacentHTML("afterbegin",items.map(n=>`<article><div><p class="kicker">${n.seccion} · ${n.author.name}</p><h2>${n.titulo}</h2><p>${n.bajada||"Sin bajada"}</p></div><aside><span>${n.estado}</span><a href="/redaccion/nota/?id=${n.id}">Ver nota</a><button data-id="${n.id}">Aprobar</button></aside></article>`).join(""));l.querySelectorAll("button").forEach(b=>b.onclick=async()=>{const r=await fetch("/api/publicar-nota.php",{method:"POST",body:new URLSearchParams({id:b.dataset.id})});const j=await r.json();if(!r.ok){alert(j.error||"No se pudo publicar");return;};alert(`Nota publicada. Verla en: ${j.url}`);location.href=j.url;});});</script></Base>
<style>
.cola-rss{padding-block:3rem 5rem}.cola-rss>header{display:flex;justify-content:space-between;align-items:end;gap:2rem;border-bottom:2px solid var(--tinta);padding-bottom:1.5rem}.cola-rss h1{margin:.25rem 0;font-size:clamp(2.2rem,5vw,4rem)}.cola-rss header p:last-child{margin:0;max-width:42rem;color:var(--gris);font:1rem/1.6 var(--sans)}.cola-rss header>a{font:700 .75rem var(--sans);color:var(--tinta);white-space:nowrap}.cola-rss__regla{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--linea);font:.78rem var(--sans)}.cola-rss__regla strong{font-weight:800;text-transform:uppercase;letter-spacing:.06em}.cola-rss__regla span{color:var(--gris)}.cola-rss__lista article{display:grid;grid-template-columns:1fr 10rem;gap:2rem;padding:1.5rem 0;border-bottom:1px solid var(--linea)}.cola-rss__lista h2{font-size:1.55rem;margin:.25rem 0 .5rem}.cola-rss__lista article>div>p:last-of-type{margin:.3rem 0 .8rem;color:var(--gris);font:1rem/1.55 var(--sans)}.cola-rss__lista a{font:700 .73rem var(--sans);color:var(--tinta);text-underline-offset:.25rem}.cola-rss__lista aside{display:flex;flex-direction:column;align-items:flex-end;gap:.75rem;font:.72rem var(--sans)}.cola-rss__lista time{color:var(--gris);text-align:right}.cola-rss__lista aside span{color:var(--rojo);font-weight:700;text-transform:uppercase;letter-spacing:.06em}.cola-rss__vacia{display:block!important;padding:3rem 0!important}.cola-rss__vacia h2{margin:0}.cola-rss__vacia p{color:var(--gris);font:1rem/1.5 var(--sans)}@media(max-width:650px){.cola-rss>header,.cola-rss__regla{align-items:flex-start;flex-direction:column}.cola-rss__lista article{grid-template-columns:1fr}.cola-rss__lista aside{align-items:flex-start}.cola-rss__lista time{text-align:left}}
</style>