---
import Base from "../../layouts/Base.astro";
---
<Base titulo="Editar nota" activa="redaccion"><main class="contenedor borrador"><header class="borrador__cab"><div><p class="kicker">Sala editorial</p><h1 id="nota-titulo">Cargando nota…</h1></div><a href="/redaccion/revisiones/">Volver a revisión</a></header><form class="borrador__form" id="nota-form"><label class="borrador__ancho">Titular<input id="titulo" required></label><label class="borrador__ancho">Bajada<textarea id="bajada" rows="3"></textarea></label><label>Sección<input id="seccion"></label><label class="borrador__ancho">Texto<textarea id="texto" rows="18"></textarea></label><label class="borrador__ancho">Fuentes<textarea id="fuentes" rows="4"></textarea></label><div class="borrador__acciones"><button>Guardar cambios</button></div><p id="mensaje"></p></form></main><script>const id=new URLSearchParams(location.search).get('id'),q=id?`/api/revision.php?action=get&id=${encodeURIComponent(id)}`:"";const fields=['titulo','bajada','seccion','texto','fuentes'];fetch(q,{credentials:'same-origin'}).then(r=>r.json()).then(({item,error})=>{if(!item)throw Error(error);document.querySelector('#nota-titulo').textContent=item.titulo;fields.forEach(f=>document.querySelector('#'+f).value=item[f]||'');}).catch(e=>document.querySelector('#mensaje').textContent=e.message);document.querySelector('#nota-form').addEventListener('submit',async e=>{e.preventDefault();const data={action:'update',id};fields.forEach(f=>data[f]=document.querySelector('#'+f).value);const r=await fetch('/api/revision.php',{method:'POST',credentials:'same-origin',body:new URLSearchParams(data)}),j=await r.json();document.querySelector('#mensaje').textContent=j.ok?'Cambios guardados.':j.error||'No se pudo guardar.';});</script></Base>