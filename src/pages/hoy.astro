---
import Base from "../layouts/Base.astro";
import titulares from "../data/titulares.json";

interface Item {
  titulo: string;
  resumen: string;
  url: string;
  medio: string;
  pais: string;
  idioma: string;
  fecha: string | null;
}

const items = titulares as Item[];

// Agrupar por día (Hoy / Ayer / fecha larga)
function claveDia(iso: string | null) {
  if (!iso) return "Sin fecha";
  const d = new Date(iso);
  if (Number.isNaN(+d)) return "Sin fecha";
  const hoy = new Date();
  const ayer = new Date();
  ayer.setDate(hoy.getDate() - 1);
  const mismoDia = (a: Date, b: Date) =>
    a.getFullYear() === b.getFullYear() &&
    a.getMonth() === b.getMonth() &&
    a.getDate() === b.getDate();
  if (mismoDia(d, hoy)) return "Hoy";
  if (mismoDia(d, ayer)) return "Ayer";
  return d.toLocaleDateString("es-AR", { weekday: "long", day: "numeric", month: "long" });
}

const grupos: { dia: string; items: Item[] }[] = [];
for (const it of items) {
  const dia = claveDia(it.fecha);
  let g = grupos.find((x) => x.dia === dia);
  if (!g) {
    g = { dia, items: [] };
    grupos.push(g);
  }
  g.items.push(it);
}

const medios = [...new Set(items.map((i) => i.medio))];
---
<Base
  titulo="Hoy"
  descripcion="Titulares de medios internacionales de análisis político y geopolítico, actualizados automáticamente."
  activa="hoy"
>
  <main class="contenedor prosa">
    <header class="hoy-pag__cab">
      <h1>Hoy · el mundo en análisis</h1>
      <p class="hoy-pag__intro">
        Selección automática de titulares de {medios.length} medios internacionales de
        análisis político y geopolítico, con foco en miradas del Sur global y no
        occidentales. Cada enlace lleva a la nota original en su fuente. Esta página se
        actualiza sola varias veces al día; Kitus no edita ni reproduce los textos.
      </p>
    </header>

    {grupos.map((g) => (
      <section class="hoy-pag__grupo">
        <h2 class="col__titulo">{g.dia}</h2>
        <ul class="hoy__lista hoy__lista--pag">
          {g.items.map((it) => (
            <li class="hoy__item">
              <a class="hoy__titulo" href={it.url} target="_blank" rel="noopener">{it.titulo}</a>
              {it.resumen && <p class="hoy__resumen">{it.resumen}</p>}
              <p class="hoy__meta">
                <span class="hoy__medio">{it.medio}</span>
                {it.pais && <span> · {it.pais}</span>}
                {it.idioma === "en" && <span class="hoy__idioma"> · EN</span>}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="hoy__nota">
      Fuentes: {medios.join(" · ")}. Para proponer o quitar un medio, se edita
      <code>scripts/fuentes.json</code>.
    </p>
  </main>
</Base>
