---
import Base from "../layouts/Base.astro";
---
<Base titulo="Página no encontrada" descripcion="La página que buscás no existe.">
  <main class="contenedor">
    <div class="prosa" style="padding:3rem 0">
      <p class="kicker">Error 404</p>
      <h1>No encontramos esa página</h1>
      <p>Puede que el enlace esté roto o que la nota se haya movido.</p>
      <p><a class="btn" href="/">Volver a la portada</a></p>
    </div>
  </main>
</Base>
