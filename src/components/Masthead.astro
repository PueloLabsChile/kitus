---
import { SITIO } from "../consts";
import Logo from "./Logo.astro";
import Nav from "./Nav.astro";
import Indicadores from "./Indicadores.astro";

interface Props { activa?: string; }
const { activa } = Astro.props;

const hoy = new Date().toLocaleDateString("es-AR", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});
const fecha = hoy.charAt(0).toUpperCase() + hoy.slice(1);
---
<header class="masthead">
  <div class="masthead__tendencias" aria-label="Temas destacados">
    <div class="contenedor masthead__tendencias-inner">
      <strong>EN FOCO</strong>
      <a href="/politica/">Pol&iacute;tica</a>
      <a href="/economia/">Econom&iacute;a</a>
      <a href="/internacional/">Internacional</a>
      <a href="/derechos/">Derechos</a>
      <a href="/multimedia/">Multimedia</a>
    </div>
  </div>
  <div class="contenedor">
    <div class="masthead__top masthead__top--izq">
      <span>{fecha}</span>
      <span>
        <a href="/quienes-somos/">Quiénes somos</a>
        <span class="sep">·</span>
        
        <span class="sep">·</span>
        <a href={SITIO.youtube} target="_blank" rel="noopener">YouTube</a>
        <span class="sep">·</span>
        <a href="/rss.xml">RSS</a>
      </span>
    </div>
    <div class="masthead__marca">
      <a href="/" aria-label={`${SITIO.nombre} — portada`}>
        <Logo />
        <p class="masthead__lema">{SITIO.lema}</p>
      </a>
    </div>
  </div>
  <div class="masthead__regla"></div>
  <Nav activa={activa} />
  <Indicadores />
</header>
