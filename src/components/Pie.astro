---
import { SITIO, SECCIONES, SECCION_SLUGS } from "../consts";
import Logo from "./Logo.astro";
const anio = new Date().getFullYear();
---
<footer class="pie">
  <div class="contenedor">
    <div class="pie__grid">
      <div class="pie__marca">
        <Logo />
        <p>{SITIO.descripcionCorta}</p>
      </div>
      <div>
        <h4>Secciones</h4>
        <ul>
          {SECCION_SLUGS.map((slug) => (
            <li><a href={`/${slug}`}>{SECCIONES[slug].nombre}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>El medio</h4>
        <ul>
          <li><a href="/quienes-somos">Quiénes somos</a></li>
          <li><a href="/quienes-somos#equipo">Equipo</a></li>
          <li><a href="/quienes-somos#contacto">Contacto</a></li>
          <li><a href="/multimedia">Multimedia</a></li>
        </ul>
      </div>
      <div>
        <h4>Seguinos</h4>
        <ul>
          <li><a href={SITIO.youtube} target="_blank" rel="noopener">YouTube</a></li>
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href="/admin/">Panel de redacción</a></li>
        </ul>
      </div>
    </div>
    <div class="pie__legal">
      <span>© {anio} {SITIO.nombre} · {SITIO.lema}</span>
      {SITIO.prototipo && <span>Prototipo — contenido de demostración</span>}
    </div>
  </div>
</footer>
