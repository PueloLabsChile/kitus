---
import titulares from "../data/titulares.json";

interface Item {
  titulo: string;
  resumen: string;
  url: string;
  medio: string;
  pais: string;
  idioma: string;
  fecha: string | null;
}

const items = (titulares as Item[]).slice(0, 7);

function cuando(iso: string | null) {
  if (!iso) return "";
  const d = new Date(iso);
  if (Number.isNaN(+d)) return "";
  return d.toLocaleDateString("es-AR", { day: "numeric", month: "short" });
}
---
{items.length > 0 && (
  <section class="hoy">
    <div class="hoy__cab">
      <h2 class="col__titulo col__titulo--rojo">Hoy · el mundo en análisis</h2>
      <a class="hoy__vertodo" href="/hoy/">Ver todo &rsaquo;</a>
    </div>
    <ul class="hoy__lista">
      {items.map((it) => (
        <li class="hoy__item">
          <a class="hoy__titulo" href={it.url} target="_blank" rel="noopener">{it.titulo}</a>
          {it.resumen && <p class="hoy__resumen">{it.resumen}</p>}
          <p class="hoy__meta">
            <span class="hoy__medio">{it.medio}</span>
            {it.pais && <span> · {it.pais}</span>}
            {it.idioma === "en" && <span class="hoy__idioma"> · EN</span>}
            {cuando(it.fecha) && <span> · {cuando(it.fecha)}</span>}
          </p>
        </li>
      ))}
    </ul>
    <p class="hoy__nota">
      Selección automática de titulares de medios internacionales de análisis político y
      geopolítico. Cada enlace lleva a la nota original en su fuente. Se actualiza sola.
    </p>
  </section>
)}
