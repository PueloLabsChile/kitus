---
import type { CollectionEntry } from "astro:content";
import { nombreSeccion } from "../consts";

interface Props {
  articulo: CollectionEntry<"articulos">;
  autor?: CollectionEntry<"autores">;
  variante?: "grande" | "riada";
}
const { articulo, autor, variante = "grande" } = Astro.props;
const { titulo, bajada, seccion, portada, etiquetas } = articulo.data;
const url = `/articulo/${articulo.id}`;
const kicker = etiquetas[0]
  ? `${nombreSeccion(seccion)} · ${etiquetas[0]}`
  : nombreSeccion(seccion);
---
<article class:list={["tarjeta", variante === "riada" && "tarjeta--riada"]}>
  <a href={url} class="tarjeta__media" aria-hidden="true" tabindex="-1">
    {portada ? <img src={portada} alt="" loading="lazy" /> : <div class="ph"></div>}
  </a>
  <div>
    <p class="kicker">{kicker}</p>
    <h3><a href={url}>{titulo}</a></h3>
    <p class="dek">{bajada}</p>
    {autor && <p class="byline">Por <strong>{autor.data.nombre}</strong></p>}
  </div>
</article>
