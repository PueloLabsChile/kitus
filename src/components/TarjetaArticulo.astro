---
import type { CollectionEntry } from "astro:content";
import { nombreSeccion, minutosLectura } from "../consts";

interface Props {
  articulo: CollectionEntry<"articulos">;
  autor?: CollectionEntry<"autores">;
  variante?: "lead" | "foto" | "normal" | "mini";
  conDek?: boolean;
  conFoto?: boolean;
}
const { articulo, autor, variante = "normal", conDek = true, conFoto } = Astro.props;
const { titulo, bajada, seccion, portada, creditoPortada, etiquetas } = articulo.data;
const url = `/articulo/${articulo.id}/`;
const min = minutosLectura(articulo.body);
const kicker = etiquetas[0]
  ? `${nombreSeccion(seccion)} · ${etiquetas[0]}`
  : nombreSeccion(seccion);

const claseVariante =
  variante === "lead" ? "hist--lead" :
  variante === "foto" ? "hist--foto" :
  variante === "mini" ? "hist--mini" : "";
const Titulo = variante === "lead" ? "h2" : "h3";
// mostrar imagen: siempre en "foto"; en el resto si hay portada (salvo que se pida lo contrario)
const mostrarFoto = portada && (conFoto ?? variante !== "lead");
---
<article class:list={["hist", claseVariante]} data-seccion={seccion}>
  {mostrarFoto && (
    <a href={url} class="hist__media" aria-hidden="true" tabindex="-1">
      <img src={portada} alt="" loading="lazy" />
      {creditoPortada && variante === "foto" && <span class="credito">{creditoPortada}</span>}
    </a>
  )}
  <p class="kicker">{kicker}</p>
  <Titulo><a href={url}>{titulo}</a></Titulo>
  {conDek && <p class="dek">{bajada}</p>}
  <div class="meta-linea">
    {autor && <span class="byline">Por <strong>{autor.data.nombre}</strong></span>}
    <span class="minutos">{min} min de lectura</span>
  </div>
</article>
