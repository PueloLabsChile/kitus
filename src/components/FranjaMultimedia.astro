---
import { SITIO } from "../consts";
import videos from "../data/videos.json";

/**
 * Franja de multimedia con videos reales del canal de Kitus.
 * La lista vive en src/data/videos.json (id de YouTube + título).
 * Las miniaturas están descargadas en public/uploads/yt-<id>.jpg.
 */
interface Props {
  cantidad?: number;
  desde?: number;
  titulo?: string;
  verTodos?: boolean;
}
const { cantidad = 3, desde = 0, titulo = "Multimedia", verTodos = true } = Astro.props;
const lista = videos.slice(desde, desde + cantidad);
const url = (id: string) => `https://www.youtube.com/watch?v=${id}`;
---
<section class="multimedia">
  <div class="contenedor">
    <h2>{titulo}</h2>
    <p class="sub">Entrevistas, informes y coberturas del canal de Kitus.</p>
    <div class="videos">
      {lista.map((v) => (
        <a class="video" href={url(v.id)} target="_blank" rel="noopener">
          <div class="thumb">
            <img src={`/uploads/yt-${v.id}.jpg`} alt="" loading="lazy" />
            <span aria-hidden="true"></span>
          </div>
          <h4>{v.titulo}</h4>
        </a>
      ))}
    </div>
    {verTodos && (
      <p style="margin-top:1.6rem">
        <a class="btn" href="/multimedia/">Ver todo el archivo audiovisual</a>
      </p>
    )}
  </div>
</section>
