---
import { SITIO } from "../consts";

/**
 * Trae los últimos videos del canal de YouTube desde su feed público (Atom).
 * Se resuelve en tiempo de build: cada vez que se publica el sitio, la franja
 * queda actualizada. Si el feed falla, muestra marcadores que enlazan al canal.
 */
const CHANNEL_ID = "UCqHkNvdvKoCJtpMZuNVlrtw";
const FEED = `https://www.youtube.com/feeds/videos.xml?channel_id=${CHANNEL_ID}`;

interface Video { titulo: string; url: string; thumb: string | null; }
let videos: Video[] = [];

try {
  const res = await fetch(FEED, { signal: AbortSignal.timeout(6000) });
  if (res.ok) {
    const xml = await res.text();
    const entradas = xml.split("<entry>").slice(1, 4);
    videos = entradas.map((e) => {
      const titulo = e.match(/<title>([\s\S]*?)<\/title>/)?.[1]?.trim() ?? "Video de Kitus";
      const url = e.match(/<link rel="alternate" href="([^"]+)"/)?.[1] ?? SITIO.youtube;
      const thumb = e.match(/<media:thumbnail url="([^"]+)"/)?.[1] ?? null;
      return { titulo, url, thumb };
    });
  }
} catch {
  // sin conexión al feed: se usa el fallback de abajo
}

const fallback: Video[] = [
  { titulo: "Entrevista: economía popular y trabajo que no se ve", url: SITIO.youtube, thumb: null },
  { titulo: "Informe: el agua como frontera del extractivismo", url: SITIO.youtube, thumb: null },
  { titulo: "Debate: medios, poder y relato en campaña", url: SITIO.youtube, thumb: null },
];
const lista = videos.length ? videos : fallback;
---
<section class="multimedia">
  <div class="contenedor">
    <h2>Multimedia</h2>
    <p class="sub">Los videos y entrevistas del canal de Kitus.</p>
    <div class="videos">
      {lista.map((v) => (
        <a class="video" href={v.url} target="_blank" rel="noopener">
          <div class="thumb" style={v.thumb ? `background-image:url(${v.thumb});background-size:cover;background-position:center` : undefined}>
            <span></span>
          </div>
          <h4>{v.titulo}</h4>
        </a>
      ))}
    </div>
    <p style="margin-top:1.6rem">
      <a class="btn" href={SITIO.youtube} target="_blank" rel="noopener">Ver el canal en YouTube</a>
    </p>
  </div>
</section>
