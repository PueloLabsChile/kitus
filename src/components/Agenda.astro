---
import agenda from "../data/agenda.json";

interface Item { titulo: string; url: string; medio: string; fecha: string | null }
const items = (agenda as Item[]).slice(0, 9);

function cuando(iso: string | null) {
  if (!iso) return "";
  const d = new Date(iso);
  if (Number.isNaN(+d)) return "";
  return d.toLocaleDateString("es-AR", { day: "numeric", month: "short" });
}
---
{items.length > 0 && (
  <section class="agenda">
    <h2 class="col__titulo">En la agenda · otras miradas</h2>
    <ul class="agenda__lista">
      {items.map((it) => (
        <li>
          <a href={it.url} target="_blank" rel="noopener">{it.titulo}</a>
          <span class="agenda__medio">{it.medio}{cuando(it.fecha) && ` · ${cuando(it.fecha)}`}</span>
        </li>
      ))}
    </ul>
    <p class="agenda__nota">Enlaces a coberturas de otros medios sobre los temas de Kitus. Esta sección se actualiza sola.</p>
  </section>
)}
